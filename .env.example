# Application
APP_NAME=KnowledgeForge AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
HOST=0.0.0.0
PORT=8000

# Gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Reliability: provider timeout, retry attempts, and circuit breaker tuning
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_ATTEMPTS=2
GEMINI_BREAKER_FAILURE_THRESHOLD=3
GEMINI_BREAKER_RECOVERY_SECONDS=30

# Retrieval experiments
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# Split chunks on Markdown headings instead of fixed-size windows
CHUNK_SECTION_AWARE=false
# Hybrid search: combine cosine similarity with a tsvector lexical rank
# (migration 009). Keep off until R3.3's real-Gemini evidence justifies it.
HYBRID_SEARCH_ENABLED=false
HYBRID_LEXICAL_WEIGHT=0.15

# Database (used from Phase 1 onward)
DATABASE_URL=postgresql://knowledgeforge:knowledgeforge@localhost:5432/knowledgeforge
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
JWT_SECRET_KEY=change-me-in-production
# Outside ENVIRONMENT=development, JWT_SECRET_KEY must be set to >= 32 chars
# or the service refuses to start.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Refresh tokens rotate on use; replay of a rotated token revokes its family.
REFRESH_TOKEN_EXPIRE_DAYS=30
GCP_PROJECT_ID=replace-me
GCS_BUCKET=knowledgeforge-uploads
PUBSUB_TOPIC=knowledgeforge-ingestion
PUBSUB_SUBSCRIPTION=knowledgeforge-ingestion-worker
# Phase 2.5 structured extraction: separate topic/subscription so extraction
# backpressure never blocks ingestion.
EXTRACTION_TOPIC=knowledgeforge-extraction
EXTRACTION_SUBSCRIPTION=knowledgeforge-extraction-worker
# Extraction schema/model; bump EXTRACTION_SCHEMA_VERSION to force re-extraction.
EXTRACTION_SCHEMA_TYPE=invoice
EXTRACTION_SCHEMA_VERSION=1
EXTRACTION_MODEL=gemini-2.0-flash
# Any field below 0.5, or overall below 0.75, flags the extraction for review.
EXTRACTION_FIELD_CONFIDENCE_THRESHOLD=0.5
EXTRACTION_OVERALL_CONFIDENCE_THRESHOLD=0.75
ASK_RATE_LIMIT_PER_MINUTE=60
DOCUMENT_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=10
# Most recent conversation messages used to rewrite follow-up questions.
CONVERSATION_HISTORY_TURNS=10
MAX_DOCUMENTS_PER_TENANT=100
MAX_UPLOAD_BYTES=10000000
MAX_BATCH_FILES=20
# USD per 1M tokens; 0.0 matches the Gemini free tier.
GEMINI_INPUT_TOKEN_COST=0
GEMINI_OUTPUT_TOKEN_COST=0
# Comma-separated origins; leave empty to disable browser cross-origin access.
CORS_ALLOWED_ORIGINS=
# Optional shared limiter. Empty uses the safe single-process fallback.
REDIS_URL=
LOCAL_EMBEDDINGS=false
# Emulator-only: deterministic local answers instead of Gemini, so /ask runs
# without credentials (local stack, chaos drills, load tests). Never in production.
LOCAL_GENERATION=false
# Emulator-only: deterministic local extraction/OCR fixtures so the extraction
# loop runs without credentials. Refused outside development.
LOCAL_EXTRACTION=false
