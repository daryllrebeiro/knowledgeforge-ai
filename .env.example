# Application
APP_NAME=KnowledgeForge AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
HOST=0.0.0.0
PORT=8000

# Gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval experiments
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Database (used from Phase 1 onward)
DATABASE_URL=postgresql://knowledgeforge:knowledgeforge@localhost:5432/knowledgeforge
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GCP_PROJECT_ID=replace-me
GCS_BUCKET=knowledgeforge-uploads
PUBSUB_TOPIC=knowledgeforge-ingestion
PUBSUB_SUBSCRIPTION=knowledgeforge-ingestion-worker
